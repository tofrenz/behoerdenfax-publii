{{#if @pagination}}
<nav class="pagination" aria-label="Seitennavigation">
    {{#if @pagination.previousPage}}<a class="kern-btn kern-btn--secondary" href="{{@pagination.previousPageUrl}}"><span class="kern-label">Neuere</span></a>{{/if}}
    {{#if @pagination.nextPage}}<a class="kern-btn kern-btn--secondary" href="{{@pagination.nextPageUrl}}"><span class="kern-label">Ältere</span></a>{{/if}}
</nav>
{{/if}}
