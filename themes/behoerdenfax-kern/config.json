{
  "name": "behoerdenfax-kern",
  "version": "1.0.0",
  "author": "Torsten Frenzel",
  "authorUrl": "https://torsten-frenzel.de",
  "license": "EUPL-1.2",
  "demoUrl": "https://behoerdenfax.de",
  "description": "Minimalistisches Publii-Theme auf Basis des KERN-UX Design Systems für die Satire-Seite Behördenfax.",
  "renderer": {
    "relatedPostsNumber": 0,
    "renderRelatedPosts": false,
    "renderSimilarPosts": false,
    "renderPrevNextPosts": false,
    "createContentStructure": true,
    "createTagPages": true,
    "createAuthorPages": true,
    "createTagsList": false,
    "createSearchPage": false,
    "create404page": true,
    "customHTML": {}
  },
  "menus": {
    "mainMenu": {
      "desc": "",
      "name": "Hauptmenü",
      "maxLevels": 1
    }
  },
  "supportedFeatures": {
    "blockEditor": true,
    "tagsList": false,
    "tagPages": true,
    "tagImages": true,
    "authorPages": true,
    "authorImages": true,
    "searchPage": false,
    "errorPage": true,
    "customSharing": false,
    "customSearch": false,
    "customComments": false,
    "embedConsents": true,
    "pages": true,
    "postsPage": false
  },
